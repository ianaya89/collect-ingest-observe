<clickhouse>
  <!--
    The official image locks the `default` user to localhost when no password
    is set, which blocks the OTel Collector connecting over the Docker network.
    Open it to any host for this local demo (no password, not for production).
  -->
  <users>
    <default>
      <networks replace="replace">
        <ip>::/0</ip>
      </networks>
    </default>
  </users>
</clickhouse>
